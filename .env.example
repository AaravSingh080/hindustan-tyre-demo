# Hindustan Tyre Agencies: tyre passport server settings.
#
# With NONE of these set, `npm start` runs the demo on this computer only: sample customers, no SMS,
# nothing sent. Setting ANY of the four keys below switches to live mode, which starts with an empty
# database and never shows sample data.
#
# On a hosting platform, enter these in its "environment" or "secrets" screen instead of a file.
# For a trial on your own computer, copy this file to .env (it is never served and never committed).

# --- required on a live site ---

# A long random string that protects sign-in codes and sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=

# The staff PIN: 6 to 12 digits, not a date, not a pattern. Eight random digits is a good choice:
#   node -e "console.log(String(require('crypto').randomInt(10000000, 100000000)))"
# Changing it and restarting signs every staff device out, and releases the lock if wrong tries have locked the PIN.
STAFF_PIN=

# The public address of the site, https, no trailing slash. QR codes and links in messages are built on it.
PUBLIC_BASE_URL=https://passport.example.com

# A folder on a disk that survives restarts and redeploys. The customer database and its daily backups live here.
DATA_DIR=/var/data/hta-passport

# --- sign-in codes by SMS (MSG91). Leave both empty and customer sign-in stays switched off. ---

# MSG91 > API > Authkey
MSG91_AUTH_KEY=
# MSG91 > OTP > Templates: the ID of the OTP template (it must contain ##OTP## and carry your DLT template ID)
MSG91_TEMPLATE_ID=

# --- optional ---

# How many proxies sit in front of the server. 1 on most hosting platforms, 0 if it faces the internet directly.
# If this is wrong, every visitor looks like one address and the limits on codes and PIN tries hit everyone at once.
TRUST_PROXY=0

# Port to listen on (most platforms set this for you).
# PORT=4173

# The most sign-in texts the server will ask MSG91 for in one hour, as a spending guard.
# SMS_HOURLY_CAP=120

# Set to "demo" only to run the demo on a public address on purpose.
# PASSPORT_MODE=demo

# --- the chat assistant ---

# With a key, the assistant on every page is Claude, told only the facts in config/chatbot.json.
# Without one it still answers, from the FAQ in that file. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# The model to use; leave empty for the default. Any Claude 5 model, or Opus/Sonnet 4.6 and later.
# CHAT_MODEL=claude-sonnet-5-5

# --- off-site backup (optional, live sites) ---

# Once a day the database copy is sent to an S3-compatible bucket: Amazon S3, Cloudflare R2, Backblaze B2,
# Wasabi and others. Set all three of bucket, key and secret, plus the region (AWS) or the endpoint (others).
BACKUP_S3_BUCKET=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
# AWS: the bucket's region, for example ap-south-1. Others: leave empty and set the endpoint instead.
# BACKUP_S3_REGION=ap-south-1
# R2: https://<account id>.r2.cloudflarestorage.com   B2: https://s3.<region>.backblazeb2.com   Wasabi: https://s3.<region>.wasabisys.com
# BACKUP_S3_ENDPOINT=
# Folder inside the bucket (default hta-passport).
# BACKUP_S3_PREFIX=hta-passport
#
# To put a copy back: stop the server, then  node server/restore.js /path/to/passport-YYYY-MM-DD.sqlite
